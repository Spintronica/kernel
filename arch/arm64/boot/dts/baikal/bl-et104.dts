// SPDX-License-Identifier: GPL-2.0
/*
 * Device tree source for Elpitech ET104 v1.0 board
 */

/dts-v1/;

#include "bl1000.dtsi"

/ {
	model = "Elpitech ET104";
	compatible = "baikal,dbl", "baikal,bl1000";

	aliases {
		ethernet0 = &sc_gmac;
		fru = &fru;
	};

	cpus {
		baikal,demand-qos = <12>;
		baikal,prefetch-qos = <10>;
		cpu@0 {
			baikal,enable-cbusy-tuning = <1>;
		};
		cpu@100 {
			baikal,enable-cbusy-tuning = <1>;
		};
		cpu@200 {
			baikal,enable-cbusy-tuning = <1>;
		};
		cpu@300 {
			baikal,enable-cbusy-tuning = <1>;
		};
	};

	chosen { };

	rfkill-wlan {
		compatible = "rfkill-gpio";
		label = "rfkill-m2e-wlan";
		radio-type = "wlan";
		shutdown-gpios = <&porte 5 GPIO_ACTIVE_HIGH>;
	};

	rfkill-bt {
		compatible = "rfkill-gpio";
		label = "rfkill-m2e-bt";
		radio-type = "bluetooth";
		shutdown-gpios = <&porte 7 GPIO_ACTIVE_HIGH>;
	};

};

&ehsp_pcie0_p0 {
	status = "okay";
	num-lanes = <4>;
	max-link-speed = <3>;
	pinctrl = <&sc_emmc_mux_gpio1>;
	reset-gpios = <&porte 1 GPIO_ACTIVE_LOW>;
};

&ehsp_pcie1_p0 {
	status = "okay";
	num-lanes = <2>;
	max-link-speed = <3>;
	reset-gpios = <&porte 2 GPIO_ACTIVE_LOW>;
};

&ehsp_pcie1_p3 {
	status = "okay";
	num-lanes = <2>;
	max-link-speed = <3>;
	reset-gpios = <&porte 4 GPIO_ACTIVE_LOW>;
};

&hsp_edp_phy {
	status = "okay";
};

&hsp_lsp_pinctrl0 {
	status = "okay";
};

&hsp_lsp_pinctrl1 {
	status = "okay";
};

&hsp_lsp_pinctrl2 {
	status = "okay";
};

&hsp_mali {
	status = "okay";
};

&hsp_vdec {
	status = "okay";
	baikal,arqos = <14>;
	baikal,awqos = <14>;
};

&hsp_vdu {
	status = "okay";
	baikal,dp-lanes = <4>;
	baikal,arqos = <13>;
	backlight {
		min-brightness-level = <10>;
		default-brightness-level = <60>;
		brightness-level-step = <2>;
		pwm-frequency = <20000>;
	};
};

&hsp_venc {
	status = "okay";
};

&mdio {
	interrupt-parent = <&porte>;
	interrupts = <13 IRQ_TYPE_LEVEL_LOW>;

	ethphy: ethernet-phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x3>;
	};
};


&sc_gmac {
	status = "okay";
	pinctrl = <&sc_gmac_sdio_bit0_mode1>,
		  <&sc_emmc_mux_gpio2>;

	phy-handle = <&ethphy>;
	phy-mode = "rgmii-rxid";

	snps,reset-gpios = <&porte 12 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <10 10200 60000>;
};

&sc_gmac_sdio_pinctrl {
	status = "okay";
};

&sc_gpio32 {
	status = "okay";
};

&hsp_gpio32 {
	status = "okay";
};

&sc_gpio30 {
	status = "okay";
};

&hsp_lsp_pinctrl0 {
	status = "okay";
};

&sc_lsp_pinctrl0 {
	status = "okay";
};

&sc_lsp_pinctrl1 {
	status = "okay";
};

&sc_lsp_pinctrl2 {
	status = "okay";
};

&sc_emmc_pinctrl {
	status = "okay";
};

&sc_emmc_pu_pinctrl {
	status = "okay";
};

&sc_emmc_pd_pinctrl {
	status = "okay";
};

&sc_uart2 {
	status = "okay";
	pinctrl = <&sc_lsp_pin12_uart2_rxd>,
		  <&sc_lsp_pin13_uart2_txd>;

	ps2mult {
		compatible = "serdev,serio";
		current-speed = <115200>;
		protocol = <0x22>; //SERIO_PS2SER
	};
};

&sc_pvt {
	status = "okay";
};

&ddr_pvt {
	status = "okay";
};

&hsp_pvt {
	status = "okay";
};

&ehsp_pvt {
	status = "okay";
};

&ca710_pvt {
	status = "okay";
};

&sc_hda {
	status = "okay";
	pinctrl = <&sc_lsp_pin14_hda_rst>,
		  <&sc_lsp_pin15_hda_sync>,
		  <&sc_lsp_pin16_hda_bclk>,
		  <&sc_lsp_pin17_hda_sdo0>,
		  <&sc_lsp_pin18_hda_sdi0>;
};

&ehsp_dp_phy {
	status = "okay";
};

&ehsp_vdu {
	status = "okay";
	baikal,dp-lanes = <4>;
	baikal,arqos = <13>;
};

&hsp_usb1_l0 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
};

&hsp_usb1_l1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "high-speed";
};

&sc_i2c0 { // M2E
	status = "okay";
	pinctrl = <&sc_lsp_pin0_i2c0_scl>,
		  <&sc_lsp_pin1_i2c0_sda>;
};

&sc_i2c1 {
	status = "okay";
	pinctrl = <&sc_lsp_pin2_i2c1_scl>,
		  <&sc_lsp_pin3_i2c1_sda>;

	fru: eeprom@50 {
		compatible = "atmel,24c256";
		reg = <0x50>;
	};
};

&sc_i2c2 {
	status = "okay";
	pinctrl = <&sc_lsp_pin4_i2c2_scl>,
		  <&sc_lsp_pin5_i2c2_sda>;

	touchpad@2c {
		reg = <0x2c>;
		compatible = "hid-over-i2c";
		reset-gpios = <&porte 19 GPIO_ACTIVE_LOW>;
		interrupts-extended = <&porte 18 IRQ_TYPE_LEVEL_LOW>;
		hid-descr-addr = <0x20>;
	};

	rtc: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
	};
};

&hsp_usb0_l0 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&hsp_usb0_phy10g_l0>;
	phy-names = "cdns3,usb3-phy";
};

&hsp_usb0_l1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&hsp_usb0_phy10g_l1>;
	phy-names = "cdns3,usb3-phy";
};

&hsp_usb0_phy10g {
	status = "okay";
};

&hsp_usb0_phy10g_l0 {
	status = "okay";
};

&hsp_usb0_phy10g_l1 {
	status = "okay";
};

&sc_i2c3 {
	status = "okay";
	pinctrl = <&sc_lsp_pin6_i2c3_scl>,
		  <&sc_lsp_pin7_i2c3_sda>;

	edid: eeprom@50 {
		compatible = "atmel,24c32";
		pagesize = <32>;
		reg = <0x50>;
	};

	eeprom@54 {
		compatible = "st,m24256";
		reg = <0x54>;
	};
};

&sc_uart0 {
	status = "okay";
	pinctrl = <&sc_lsp_pin8_uart0_rxd>,
		  <&sc_lsp_pin9_uart0_txd>;
};

&sc_uart1 {
	status = "okay";
	pinctrl = <&sc_lsp_pin10_uart1_rxd>,
		  <&sc_lsp_pin11_uart1_txd>;
};

&hsp_i2c0 {
	status = "okay";
	pinctrl = <&hsp_lsp_pin0_i2c0_scl>,
		  <&hsp_lsp_pin1_i2c0_sda>;
};

&hsp_i2c1 {
	status = "okay";
	pinctrl = <&hsp_lsp_pin2_i2c1_scl>,
		  <&hsp_lsp_pin3_i2c1_sda>;
};

&hsp_i2c2 {
	status = "okay";
	pinctrl = <&hsp_lsp_pin4_i2c2_scl>,
		  <&hsp_lsp_pin5_i2c2_sda>;
};

&hsp_i2c3 { /* Connected to DIMM SPDs */
	status = "okay";
	pinctrl = <&hsp_lsp_pin6_i2c3_scl>,
		  <&hsp_lsp_pin7_i2c3_sda>;
};

