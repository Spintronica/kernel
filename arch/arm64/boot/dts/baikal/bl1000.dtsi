		hsp_edp_phy_reset: reset-controller@28840010 {
			compatible = "baikal,bl1000-reset";
			reg = <0x0 0x28840010 0x0 0x4>;
			#reset-cells = <1>;
		};

		hsp_edp_lane_reset: reset-controller@2a440100 {
			compatible = "baikal,bl1000-reset";
			reg = <0x0 0x2a440100 0x0 0x4>;
			#reset-cells = <1>;
			active-low;
		};

		hsp_edp_phy: torrent-phy@2a400000 {
			compatible = "baikal,dp-phy";
			reg = <0x0 0x2a400000 0x0 0x00040000>,
			      <0x0 0x2a440000 0x0 0x00000100>;
			reg-names = "torrent_phy", "dptx_phy";
			resets = <&hsp_edp_phy_reset 5>,
				 <&hsp_gpr_mmrst0 8>;
			reset-names = "torrent_reset", "torrent_apb";
			clocks = <&refclk100mhz>;
			clock-names = "refclk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			edp_phy: phy@0 {
				reg = <0>;
				resets = <&hsp_edp_lane_reset 2>,
					 <&hsp_edp_lane_reset 5>,
					 <&hsp_edp_lane_reset 10>,
					 <&hsp_edp_lane_reset 13>,
					 <&hsp_edp_lane_reset 1>,
					 <&hsp_edp_lane_reset 4>,
					 <&hsp_edp_lane_reset 9>,
					 <&hsp_edp_lane_reset 12>;
				#phy-cells = <0>;
				cdns,phy-type = <PHY_TYPE_DP>;
				cdns,num-lanes = <4>;
				cdns,max-bit-rate = <8100>;
			};
		};

		hsp_vdu: vdu@2a480000 {
