			reg-shift = <2>;
			reg-io-width = <4>;
			clocks = <&hsp_cmu0_clkch 22>, <&hsp_cmu0_clkch 21>;
			clock-names = "baudclk", "apb_pclk";
			status = "disabled";
		};

		hsp_uart3: serial@2b080000 {
			compatible = "baikal,bl1000-uart";
			reg = <0x0 0x2b080000 0x0 0x100>;
			interrupts = <GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>;
			reg-shift = <2>;
			reg-io-width = <4>;
