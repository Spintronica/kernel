			interrupt-names = "dma0", "dma1", "dma2", "dma3",
					  "dma4", "dma5", "dma6", "dma7";
			num-ib-windows = <4>;
			num-ob-windows = <4>;
			status = "disabled";
		};

		ehsp_pcie0_p1: pcie@34400000 {
			compatible = "baikal,bl1000-pcie";
