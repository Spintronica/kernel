					  "intr";
			#interrupt-cells = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x81000000 0x00 0x00400000 0x67 0xe0000000 0x0 0x100000>,
				 <0x82000000 0x00 0x40000000 0x67 0x40000000 0x0 0x40000000>,
