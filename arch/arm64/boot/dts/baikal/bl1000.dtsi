		sc_gic: interrupt-controller@3000000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x3000000 0x0 0x10000>,  /* GICD */
			      <0x0 0x30c0000 0x0 0x600000>; /* GICR */
			#interrupt-cells = <3>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;

			its0: msi-controller@3040000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x3040000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
			};
			its1: msi-controller@3080000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x3080000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
			};
		};

