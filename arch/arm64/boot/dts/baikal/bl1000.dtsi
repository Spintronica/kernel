		ehsp_pcie0_p0: pcie@34000000 {
			compatible = "baikal,bl1000-pcie";
			reg = <0x00 0x34000000 0x0 0x300000>,
			      <0x00 0x34300000 0x0 0x800>,
			      <0x00 0x34380000 0x0 0x800>,
			      <0x00 0x32540000 0x0 0x100>,
			      <0x47 0xf0000000 0x0 0x10000000>;
			reg-names = "dbi", "atu", "dma", "apb", "config";
			device_type = "pci";
			bus-range = <0x0 0xff>;
			interrupts = <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 298 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 299 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dma0", "dma1", "dma2", "dma3",
					  "dma4", "dma5", "dma6", "dma7",
					  "intr";
			#interrupt-cells = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x81000000 0x00 0x00000000 0x47 0xe0000000 0x0 0x100000>,
				 <0x82000000 0x00 0x40000000 0x47 0x40000000 0x0 0x40000000>,
				 <0x82000000 0x40 0x00000000 0x40 0x00000000 0x7 0x40000000>;
			num-viewport = <4>;
			msi-parent = <&its0 0x0>;
			msi-map = <0x0 &its0 0x0 0x10000>;
			status = "disabled";
		};

		ehsp_pcie0_p0_ep: pcie-ep@34000000 {
			compatible = "baikal,bl1000-pcie-ep";
			reg = <0x00 0x34000000 0x0 0x300000>,
			      <0x00 0x34300000 0x0 0x800>,
			      <0x00 0x32540000 0x0 0x100>,
			      <0x40 0x00000000 0x1 0x00000000>;
			reg-names = "dbi", "atu", "apb", "addr_space";
			interrupts = <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 298 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 299 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>,
