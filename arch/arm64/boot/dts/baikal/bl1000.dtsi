		hsp_smmu: iommu@2a000000 {
			compatible = "arm,smmu-v3";
			reg = <0x0 0x2a000000 0x0 0x100000>;
			interrupts = <GIC_SPI 216 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 225 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 217 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 219 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "eventq", "priq", "cmdq-sync", "gerror";
			#iommu-cells = <1>;
			status = "disabled";
		};

		hsp_vdec: video-codec@2a200000 {
			compatible = "baikal,bl1000-vdpu";
			reg = <0x0 0x2a200000 0x0 0x100000>;
			interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "vdpu";
			clocks = <&hsp_cmu0_clkch 1>, <&hsp_cmu0_clkch 2>;
			clock-names = "aclk", "pclk";
			status = "disabled";
		};

		hsp_venc: video-codec@2a300000 {
			compatible = "baikal,bl1000-vepu";
			reg = <0x0 0x2a300000 0x0 0x100000>;
