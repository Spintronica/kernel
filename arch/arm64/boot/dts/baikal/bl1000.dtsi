		ehsp_pcie1_p1: pcie@35400000 {
			compatible = "baikal,bl1000-pcie";
			reg = <0x00 0x35400000 0x0 0x300000>,
			      <0x00 0x35700000 0x0 0x800>,
			      <0x00 0x35780000 0x0 0x800>,
			      <0x00 0x32741000 0x0 0x100>,
			      <0x6f 0xf0000000 0x0 0x10000000>;
			reg-names = "dbi", "atu", "dma", "apb", "config";
			device_type = "pci";
			bus-range = <0x0 0xff>;
			interrupts = <GIC_SPI 319 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "intr";
			#interrupt-cells = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x81000000 0x00 0x00500000 0x6f 0xe0000000 0x0 0x100000>,
				 <0x82000000 0x00 0x40000000 0x6f 0x40000000 0x0 0x40000000>,
				 <0x82000000 0x68 0x00000000 0x68 0x00000000 0x7 0x40000000>;
			num-viewport = <4>;
			msi-parent = <&its1 0x10000>;
			msi-map = <0x0 &its1 0x10000 0x10000>;
			status = "disabled";
		};

		ehsp_pcie1_p2: pcie@35800000 {
			compatible = "baikal,bl1000-pcie";
			reg = <0x00 0x35800000 0x0 0x300000>,
			      <0x00 0x35b00000 0x0 0x800>,
			      <0x00 0x35b80000 0x0 0x800>,
			      <0x00 0x32742000 0x0 0x100>,
			      <0x77 0xf0000000 0x0 0x10000000>;
			reg-names = "dbi", "atu", "dma", "apb", "config";
			device_type = "pci";
			bus-range = <0x0 0xff>;
			interrupts = <GIC_SPI 320 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "intr";
			#interrupt-cells = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x81000000 0x00 0x00600000 0x77 0xe0000000 0x0 0x100000>,
				 <0x82000000 0x00 0x40000000 0x77 0x40000000 0x0 0x40000000>,
				 <0x82000000 0x70 0x00000000 0x70 0x00000000 0x7 0x40000000>;
			num-viewport = <4>;
			msi-parent = <&its1 0x20000>;
			msi-map = <0x0 &its1 0x20000 0x10000>;
			status = "disabled";
		};

		ehsp_pcie1_p3: pcie@35c00000 {
			compatible = "baikal,bl1000-pcie";
			reg = <0x00 0x35c00000 0x0 0x300000>,
			      <0x00 0x35f00000 0x0 0x800>,
			      <0x00 0x35f80000 0x0 0x800>,
			      <0x00 0x32743000 0x0 0x100>,
			      <0x7f 0xf0000000 0x0 0x10000000>;
			reg-names = "dbi", "atu", "dma", "apb", "config";
			device_type = "pci";
			bus-range = <0x0 0xff>;
			interrupts = <GIC_SPI 321 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "intr";
			#interrupt-cells = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x81000000 0x00 0x00700000 0x7f 0xe0000000 0x0 0x100000>,
				 <0x82000000 0x00 0x40000000 0x7f 0x40000000 0x0 0x40000000>,
				 <0x82000000 0x78 0x00000000 0x78 0x00000000 0x7 0x40000000>;
			num-viewport = <4>;
			msi-parent = <&its1 0x30000>;
			msi-map = <0x0 &its1 0x30000 0x10000>;
			status = "disabled";
		};

		ehsp_dp_phy_reset: reset-controller@30840000 {
			compatible = "baikal,bl1000-reset";
			reg = <0x0 0x30840000 0x0 0x4>;
			#reset-cells = <1>;
		};

		ehsp_dp_lane_reset: reset-controller@32240100 {
			compatible = "baikal,bl1000-reset";
			reg = <0x0 0x32240100 0x0 0x4>;
			#reset-cells = <1>;
			active-low;
		};

		ehsp_dp_phy: torrent-cdns-phy@32200000 {
			compatible = "baikal,dp-phy";
			reg = <0x0 0x32200000 0x0 0x00040000>,
			      <0x0 0x32240000 0x0 0x00000100>;
			reg-names = "torrent_phy", "dptx_phy";
			resets = <&ehsp_dp_phy_reset 17>,
				 <&ehsp_dp_phy_reset 18>;
			reset-names = "torrent_reset", "torrent_apb";
			clocks = <&refclk100mhz>;
			clock-names = "refclk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			dp_phy: phy@0 {
				reg = <0>;
				resets = <&ehsp_dp_lane_reset 2>,
					 <&ehsp_dp_lane_reset 5>,
					 <&ehsp_dp_lane_reset 10>,
					 <&ehsp_dp_lane_reset 13>,
					 <&ehsp_dp_lane_reset 1>,
					 <&ehsp_dp_lane_reset 4>,
					 <&ehsp_dp_lane_reset 9>,
					 <&ehsp_dp_lane_reset 12>;
				#phy-cells = <0>;
				cdns,phy-type = <PHY_TYPE_DP>;
				cdns,num-lanes = <4>;
				cdns,max-bit-rate = <8100>;
			};
		};

		ehsp_vdu: vdu@32280000 {
			compatible = "baikal,bl1000-vdu";
			reg = <0x0 0x32280000 0x0 0x10000>,
			      <0x0 0x32300000 0x0 0x10000>;
			reg-names = "dp_base", "dp0_regs";
			interrupt-parent = <&sc_gic>;
			interrupts = <GIC_SPI 256 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 258 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dp0_irq", "dptx_irq";
			clocks = <&ehsp_cmu1_pll>,
				 <&ehsp_cmu0_clkch 0>;
			clock-names = "dp0_pclk",
				      "s_axi_aclk";
			phys = <&dp_phy 0>;
			phy-names = "dp_phy";
			status = "disabled";
		};

		sc_pvt: pvt@850000 {
			compatible = "baikal,bl1000-pvt";
			reg = <0x0 0x850000 0x0 0x1000>;
			interrupts = <GIC_SPI 504 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sc_pvt_clkch 0>;
			clock-names = "ref";
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		ddr_pvt: pvt@8850000 {
			compatible = "baikal,bl1000-pvt";
			reg = <0x0 0x8850000 0x0 0x1000>;
			interrupts = <GIC_SPI 416 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ddr_pvt_clkch 0>;
			clock-names = "ref";
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		hsp_pvt: pvt@28850000 {
			compatible = "baikal,bl1000-pvt";
			reg = <0x0 0x28850000 0x0 0x1000>;
			interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&hsp_pvt_clkch 0>;
			clock-names = "ref";
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		ehsp_pvt: pvt@30850000 {
			compatible = "baikal,bl1000-pvt";
			reg = <0x0 0x30850000 0x0 0x1000>;
			interrupts = <GIC_SPI 322 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ehsp_pvt_clkch 0>;
			clock-names = "ref";
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		ca710_pvt: pvt@38850000 {
			compatible = "baikal,bl1000-pvt";
			reg = <0x0 0x38850000 0x0 0x1000>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ca710_pvt_clkch 0>;
			clock-names = "ref";
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};
	};

	thermal-zones {
		PVT_THERMAL(sc);
		PVT_THERMAL(ddr);
		PVT_THERMAL(hsp);
		PVT_THERMAL(ehsp);

		thermal-ca710 {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;
			thermal-sensors = <&ca710_pvt>;

			trips {
				ca710_alert: ca710-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				crit {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&ca710_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};
};
